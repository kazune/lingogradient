#!/usr/bin/env bash

request=$(cat)

if [[ -n ${EXPECTED_MODEL:-} ]] &&
  ! jq -e --arg expected "$EXPECTED_MODEL" '.model == $expected' <<<"$request" >/dev/null; then
  echo "unexpected model" >&2
  exit 1
fi

case ${CURL_MODE:-success} in
  success)
    jq -cn --arg response '{"sentences":[{"ja":"一。","en":"One."},{"ja":"二。","en":"Two."},{"ja":"三。","en":"Three."},{"ja":"四。","en":"Four."}]}' \
      '{response: $response}'
    ;;
  invalid)
    jq -cn --arg response 'not json' '{response: $response}'
    ;;
  failure)
    echo "curl: (22) The requested URL returned error: 500" >&2
    exit 22
    ;;
esac
